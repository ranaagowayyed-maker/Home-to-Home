server {
  listen ${PORT};
  root /usr/share/nginx/html;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # Resolve the API's private hostname per request: every API deploy gets a new private
  # address, and a static proxy_pass would keep the address seen at startup forever.
  resolver ${NGINX_RESOLVER} valid=10s;

  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    # Pass the edge's X-Forwarded-For through untouched: its last entry is the real client,
    # which the API uses for rate limiting. API_UPSTREAM is the API's private address.
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-Id $request_id;
    client_max_body_size 1m;
  }

  location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
